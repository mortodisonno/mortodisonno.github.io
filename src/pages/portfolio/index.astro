---
import Layout from '../../layouts/Layout.astro';

const works = [
  {
    title: 'Mountain Side Fest 2025',
    subtitle: 'TONES Teatro Natura, Val DOssola - projectionist, media server operator' ,
    url: 'https://www.youtube.com/watch?v=va8YrT0hFzk',
  },
  {
    title: 'Piotr Uklanski : Faux Amis',
    subtitle: 'Pinacoteca Giovanni Agnelli Torino - animations' ,
    url: 'https://www.youtube.com/watch?v=URgPu0HE8z4',
  },
  {
    title: 'Il Trittico',
    subtitle: 'Teatro Regio di Torino - projectionist, media server operator' ,
    url: 'https://youtu.be/Aq0IEbCS7sc',
  },
  {
    title: 'Le Villi',
    subtitle: 'Teatro Regio di Torino - projectionist, media server operator' ,
    url: 'https://www.juanguillermonova.com/copia-de-mefistofele-1',
  },
  {
    title: 'Basic Business Week',
    subtitle: 'Basic Village Torino - LED walls, media server operator ' ,
    url: 'media.basicpress.com/media/media/192/192630_001.JPG',
  },
];
---

<Layout title="portfolio — mortodisonno">
  <section>
    <h1>portfolio</h1>
    <p class="muted">live video tech/projectionist/media server op.</p>
  </section>

  <section>
    {works.map((work) => (
      <div class="work">
        <a href={work.url} target="_blank" rel="noopener">{work.title}</a>
        {work.subtitle && <span class="muted"> — {work.subtitle}</span>}
      </div>
    ))}
  </section>
</Layout>

<style>
  .muted { color: var(--muted); }
  .work {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
</style>

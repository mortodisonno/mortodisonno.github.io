    url: 'https://youtu.be/Aq0IEbCS7sc',
  },
  {
    title: 'Le Villi',
    subtitle: 'Teatro Regio di Torino - proiezionista, operatore media server',
    url: 'https://www.juanguillermonova.com/copia-de-mefistofele-1',
  },
    {
    title: 'Subsonica I CIELI SU TORINO 96-26',
    subtitle: 'OGR Officine Grandi Riparazioni Torino - montaggio LED walls',
    url: 'https://youtu.be/2xye_8RB7Aw?si=3fYi82TxRaj5mstO',
   },
  {

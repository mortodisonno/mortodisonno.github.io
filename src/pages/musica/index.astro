---
import Layout from '../../layouts/Layout.astro';
import { albums } from '../../data/discografia';
import { getEntry, render } from 'astro:content';

const intro = await getEntry('pages', 'musica');
const { Content } = await render(intro);

const BASE = 'https://server-latitudee6500.tailf97aec.ts.net/musica';
---

<Layout title="Musica — mortodisonno">
  <section class="intro">
    <h1>musica</h1>
    <p class="tagline">ne dio//ne stato//ne algoritmo//ne patriarcato</p>
    <div class="prose"><Content /></div>
  </section>

  <section class="discography">
    {albums.map((album, i) => (
      <details class="album" open={i === 0}>
        <summary>
          <span class="album-title">{album.title}</span>
          <span class="album-meta">
            {[album.anno, album.etichetta, album.tipo].filter(Boolean).join(' · ')} · {album.tracks.length} tracce
          </span>
        </summary>
        {album.tracks.map((track, j) => (
          <div class="track">
            <span class="n">{String(j + 1).padStart(2, '0')}</span>
            <span class="title">{track.title}</span>
            <audio controls preload="none" src={`${BASE}/${album.dir}/${track.file}`}></audio>
          </div>
        ))}
      </details>
    ))}
  </section>
</Layout>

<style>
  /* intro */
  .intro {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }
  .tagline {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }
  .intro p {
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  /* discografia */
  .discography { max-width: 42rem; }

  details.album {
    border: 1px solid var(--border);
    margin-bottom: 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.02);
  }

  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker { display: none; }

  summary::before {
    content: '+';
    color: var(--cyan);
    font-family: monospace;
    margin-right: 0.6rem;
    transition: transform 0.15s ease;
  }
  details[open] summary::before { content: '−'; }

  .album-title { font-size: 0.95rem; }
  .album-meta {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* su schermi stretti lascio andare a capo la meta invece di tagliarla */
  @media (max-width: 640px) {
    summary { flex-wrap: wrap; }
    .album-meta { white-space: normal; }
  }

  .track {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.3rem 0.9rem 0.3rem 2.2rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }
  .track:hover .n { color: var(--cyan); }

  .n {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--muted);
    min-width: 1.4rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .title {
    flex: 1;
    font-size: 0.85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .track audio { height: 1.8rem; width: 13rem; }

  @media (max-width: 640px) {
    .track { flex-wrap: wrap; }
    .track audio { width: 100%; order: 3; }
  }
</style>

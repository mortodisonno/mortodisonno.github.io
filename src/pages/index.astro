---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import { getEntry, render } from 'astro:content';

const bio = await getEntry('pages', 'bio');
const { Content } = await render(bio);
---

<Layout title="ciao, mi chiamo alekos">
  <section class="bio">
    <img src="/profile.jpg" alt="Alekos" width="180" height="180" />
    <div class="bio-text">
      <h1>ciao, mi chiamo alekos</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <Newsletter />
</Layout>

<style>
  .bio {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 34rem;
    margin: 0 auto;
  }

  .bio img {
    width: 700px;
    height: 150px;
    object-fit: cover;
    border-radius: 5%;
    filter: grayscale(30%);
  }

  .bio h1 {
    margin: 0;
    font-size: 1rem;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .prose a {
    color: var(--accent);
  }
</style>

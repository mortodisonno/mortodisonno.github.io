---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const bio = await getEntry('pages', 'bio');
const { Content } = await render(bio);
---

<Layout title="ciao, mi chiamo alekos">
  <section class="bio">
    <img src="/profile.jpg" alt="Alekos" width="180" height="180" />
    <div class="bio-text">
      <h1>ciao, mi chiamo alekos</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Layout>

<style>
  .bio {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 34rem;
    margin: 0 auto;
  }
  .bio img {
    width: 100%;
    max-width: 1280px
    height: auto;
    object-fit: contain;
    border-radius: 0%;
    display: block
    filter: grayscale(30%);
  }
  .bio h1 { margin: 0; }
  .bio-text { display: flex; flex-direction: column; gap: 1rem; }
  .links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    font-size: 0.85rem;
  }
  .prose a { color: var(--primary); }
</style>
